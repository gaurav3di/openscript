# Internal working notes, not part of the published project.
PLAN.md
notes/

# Built output for the unit tests.
dist-test/

# The compiler's view of the error catalogue, written by
# scripts/generate-error-catalogue.mjs from spec/errors.json on every build. A
# checked-in copy would be a second source of truth, which is the one thing the
# catalogue exists to prevent.
src/core/catalogue/*.generated.ts
src/core/version/*.generated.ts

# The one line the specification gives each library name, written by
# scripts/generate-library-prose.mjs from spec/stdlib.md and spec/language.md on
# every build. Checked in, it would be a second place a function's description
# lives, and the one an editor shows.
src/core/check/*.generated.ts
