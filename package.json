{
  "name": "openalgo-script",
  "version": "0.1.0-alpha.1",
  "description": "An open trading language. Write a study or a strategy once, plot it, backtest it, trade it.",
  "keywords": [
    "trading",
    "language",
    "compiler",
    "indicators",
    "backtesting",
    "technical-analysis"
  ],
  "homepage": "https://github.com/marketcalls/openscript#readme",
  "bugs": {
    "url": "https://github.com/marketcalls/openscript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marketcalls/openscript.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./charts": {
      "types": "./dist/adapters/charts/index.d.ts",
      "import": "./dist/adapters/charts/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist",
    "spec/errors.json",
    "src"
  ],
  "scripts": {
    "check:names": "node scripts/check-names.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:errors": "node scripts/check-error-codes.mjs",
    "test": "node scripts/check-duplication.mjs && node scripts/check-error-codes.mjs && node scripts/check-examples.mjs && node scripts/check-layering.mjs && node scripts/check-limits.mjs && node scripts/check-modularity.mjs && node scripts/check-names.mjs && npm run build && npm run test:unit && npm run bench",
    "test:unit": "npm run generate && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:limits": "node scripts/check-limits.mjs",
    "check:modularity": "node scripts/check-modularity.mjs",
    "generate:errors": "node scripts/generate-error-catalogue.mjs",
    "typecheck": "npm run generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "npm run generate && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "generate:version": "node scripts/generate-version.mjs",
    "generate": "npm run generate:errors && npm run generate:version",
    "check:changelog": "node scripts/check-changelog.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:record": "node scripts/bench.mjs --record"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "peerDependencies": {
    "openalgo-charts": ">=2.4.0"
  },
  "peerDependenciesMeta": {
    "openalgo-charts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
