// The rawest reading there is: this bar's price against the price a fixed
// number of bars ago, with no smoothing and no normalisation.
//
// Exercises: a study whose scale is the instrument's own, bar colouring from
// the sign of the reading, and the difference between a reading of zero and no
// reading at all.

version 1

study("Price momentum", precision = 2)

len = input(10, "Length", min = 1, max = 500)

value = close - close[len]

level(0, "Zero", fade(silver, 50), style = "dashed")

plot(value, "Momentum", purple, width = 2, style = "histogram")

barColor(value > 0 ? lime : value < 0 ? red : none)
