// How far the close sits below the high of its own recent range, as a
// percentage of that range, so a fresh high reads exactly zero and a fresh low
// exactly minus one hundred.
//
// Exercises: a reading whose scale is negative, pane shading for a regime, two
// reference levels and a marker that fires on the way back out of an extreme
// rather than on every bar spent inside it.

version 1

study("Percent range", precision = 2, range = [-100, 0])

len = input(14, "Length", min = 1, max = 500)

top    = highest(high, len)
bottom = lowest(low, len)
span   = top - bottom

// A window with no range at all is a division with no answer, which is absence
// rather than a zero: nothing is known about where the close sits in a range
// that does not exist.
value = span == 0 ? none : 100 * (close - top) / span

level(-20, "Upper band", fade(silver, 40))
level(-50, "Middle", fade(silver, 60), style = "dashed")
level(-80, "Lower band", fade(silver, 40))

plot(value, "Percent range", purple, width = 2)

// The shading is the state, and the marker is the change of state. Drawing both
// is the point: a reader wants to see how long price spent at an extreme as
// well as the bar it left it on.
high20 = not isNone(value) and value > -20
low80  = not isNone(value) and value < -80
background(high20 ? fade(red, 92) : low80 ? fade(lime, 92) : none)

if not high20 and orElse(high20[1], false)
    signal("LEAVING HIGH", red, at = "above", shape = "triangleDown")

if not low80 and orElse(low80[1], false)
    signal("LEAVING LOW", lime, at = "below", shape = "triangleUp")
