// The window's outright high, its midpoint and its outright low.
//
// Exercises a library call with three outputs read by index, and a band shaded
// between the outer two.

version 1

study("Channel rails", overlay = true, precision = 2)

len = input(20, "Length", min = 1, max = 1000)

channel = donchian(len)

topRail    = plot(element(channel, 0), "Upper", aqua)
plot(element(channel, 1), "Basis", orange, width = 2)
bottomRail = plot(element(channel, 2), "Lower", aqua)
fill(topRail, bottomRail, fade(aqua, 92))
