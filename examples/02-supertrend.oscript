// A trailing volatility stop: the two raw bands it is built from, the one band
// that is live, and the price candles recoloured by which side price is on.
//
// Exercises: var across bars, reading a var before it is reassigned to get the
// previous bar's value, atr, the ternary with none to hide a plot, barColor,
// and a self referencing series that would be absent forever without orElse.

version 1

study("Trailing volatility stop", overlay = true, precision = 2)

atrLen = input(10,  "ATR length", min = 1, max = 200)
mult   = input(3.0, "Band width, in ATR", min = 0.5, max = 20)
paint  = input(true, "Recolour the candles")

atrValue = atr(atrLen)

// The raw bands. These are recomputed from scratch every bar and are what the
// trailing bands are pulled towards.
rawLower = hl2 - mult * atrValue
rawUpper = hl2 + mult * atrValue

var lowerBand = none
var upperBand = none
var dir = 1

// Read the two bands before they are reassigned below. A var still holds the
// previous bar's value at this point in the file, which is the whole reason the
// direction test and the band trail can both be written without a [1] read.
prevLower = lowerBand
prevUpper = upperBand

// orElse is doing real work here: on bar 0 the previous band is absent, the
// comparison is absent, the branch is not taken, and the band seeds from the
// raw value instead of staying absent for the rest of the dataset.
lowerBand = close[1] > orElse(prevLower, rawLower) ? max(rawLower, prevLower) : rawLower
upperBand = close[1] < orElse(prevUpper, rawUpper) ? min(rawUpper, prevUpper) : rawUpper

// Direction flips against the band as it stood on the previous bar, not against
// the band this bar just produced, or every bar would flip its own trigger.
if not isNone(prevUpper) and close > prevUpper
    dir = 1
else if not isNone(prevLower) and close < prevLower
    dir = -1

stopLine = dir == 1 ? lowerBand : upperBand

// Two plots rather than one, because one column cannot change colour partway
// along and a stop that switches sides has to be two lines with a gap in each.
plot(dir ==  1 ? stopLine : none, "Stop, long",  lime, width = 2)
plot(dir == -1 ? stopLine : none, "Stop, short", red,  width = 2)

plot(rawUpper, "Upper band", fade(silver, 60))
plot(rawLower, "Lower band", fade(silver, 60))
fill(rawUpper, rawLower, fade(silver, 94))

barColor(paint ? (dir == 1 ? lime : red) : none)

// bar.isFirst guards the flip test because != is total: on bar 0 the previous
// direction is absent, dir != dir[1] is true, and the study would mark a flip
// that never happened.
if not bar.isFirst and dir != dir[1]
    signal(dir == 1 ? "TREND UP" : "TREND DOWN")
